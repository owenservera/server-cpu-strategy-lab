  "notes": "Starter ontology from docs/research/demand-2030/TAXONOMY-AND-ACCOUNTING.md. Segments are multi-axis classifications, not market-share claims. Only explicit additive partitions may be summed.",
  "axes": [
    {"id":"buyer","label":"Economic hardware buyer","meaning":"Buyer who pays for or owns physical CPU equipment; not necessarily cloud service consumer","additive":true},
    {"id":"channel","label":"Procurement channel","meaning":"OEM/ODM/reseller route to the same physical purchase","additive":true},
    {"id":"workload","label":"Workload type","meaning":"CPU work performed; often shared across a purchased socket","additive":false},
    {"id":"workload_pool","label":"Nonoverlapping modeled CPU revenue pools","meaning":"Accounting groups foundational/AI host/new dedicated agent execution","additive":true},
    {"id":"isa","label":"CPU architecture","meaning":"CPU ISA; not GPU or server-system architecture","additive":true},
    {"id":"deployment","label":"Execution placement","meaning":"Distinct endpoint/local, on-prem and cloud execution sites","additive":true},
    {"id":"geography","label":"Region","meaning":"Location of hardware purchase/deployment; null when unknown","additive":true}
  ],
