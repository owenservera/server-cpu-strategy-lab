{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/owenservera/server-cpu-strategy-lab/blob/main/research/schema/packet.schema.json",
  "title": "CORE/SIGNAL multipath public research transaction",
  "description": "One logical intake event, multiple route outputs. New packets are staged evidence, NOT automatically promoted canonical data.",
  "type": "object",
  "required": [
    "schema_version",
    "packet_id",
    "created_at",
    "title",
    "status",
    "public_only",
    "domains",
    "routes",
    "search_before_write",
    "sources",
    "claims",
    "measurements",
    "forecasts",
    "hypotheses",
    "questions",
    "conflicts",
    "promotions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}--[a-z0-9][a-z0-9-]*$"
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "status": {
      "enum": [
        "staged",
        "needs_review",
        "partially_promoted",
        "promoted",
        "archived"
      ]
    },
    "sample_only": {
      "type": "boolean",
      "default": false
    },
    "public_only": {
      "const": true
    },
    "scope": {
      "type": "string"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "search_before_write": {
      "type": "object",
      "required": [
        "checked_paths",
        "dedupe_notes"
      ],
      "properties": {
        "checked_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "prior_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dedupe_notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measurement"
      }
    },
    "forecasts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/forecast"
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/signal"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/method"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "promotions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/promotion"
      }
    },
    "handoff": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed_decisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "financial_filings": {
      "type": "array",
      "description": "Optional source-backed financial filing records. Presence does not mean downloaded or reviewed.",
      "items": {
        "$ref": "#/$defs/financial_filing"
      }
    },
    "financial_commitments": {
      "type": "array",
      "description": "Optional non-additive contractual/financing disclosures with source locators and economic boundaries.",
      "items": {
        "$ref": "#/$defs/financial_commitment"
      }
    }
  },
  "additionalProperties": false,
